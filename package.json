    "dev": "concurrently \"content-collections watch\" \"next dev --turbo -p 3001\"",
    "build": "content-collections build && next build",
    "build:docs": "content-collections build",
    "start": "next start",
    "lint": "next lint",
    "format:fix": "prettier --write ."
